---
/**
 * Link styled as a button (or a real <button> when no href is given).
 *  variant: primary (solid), secondary (outline), quiet (text + icon)
 */
import Icon, { type IconName } from './Icon.astro';
import { isExternal } from '../lib/format';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'quiet';
  size?: 's' | 'm';
  icon?: IconName;
  iconRight?: IconName;
  download?: boolean | string;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'secondary',
  size = 'm',
  icon,
  iconRight,
  download,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const external = isExternal(href);
const trailing = iconRight ?? (external && variant !== 'quiet' && !icon ? 'external' : undefined);
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className];
---

{
  href ? (
    <a href={href} class:list={classes} download={download} {...rest}>
      {icon && <Icon name={icon} class="btn__icon" />}
      <span class="btn__label">
        <slot />
      </span>
      {trailing && <Icon name={trailing} class="btn__icon btn__icon--right" />}
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      {icon && <Icon name={icon} class="btn__icon" />}
      <span class="btn__label">
        <slot />
      </span>
      {trailing && <Icon name={trailing} class="btn__icon btn__icon--right" />}
    </button>
  )
}

<style>
  .btn {
    --btn-pad-y: 0.72rem;
    --btn-pad-x: 1.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55em;
    min-height: 2.75rem;
    padding: var(--btn-pad-y) var(--btn-pad-x);
    border: 1px solid transparent;
    border-radius: var(--radius-m);
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 560;
    letter-spacing: 0.01em;
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .btn--s {
    --btn-pad-y: 0.5rem;
    --btn-pad-x: 0.8rem;
    min-height: 2.25rem;
  }

  .btn :global(.btn__icon) {
    width: 1.05em;
    height: 1.05em;
  }

  .btn--primary {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }

  .btn--primary:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .btn--secondary {
    border-color: var(--color-border-strong);
    background: transparent;
    color: var(--color-text);
  }

  .btn--secondary:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }

  .btn--quiet {
    min-height: 2.75rem;
    padding-inline: 0.2rem;
    color: var(--color-text-muted);
    background: none;
  }

  .btn--quiet:hover {
    color: var(--color-accent);
  }

  .btn:hover :global(.btn__icon--right) {
    transform: translateX(2px);
  }

  .btn :global(.btn__icon--right) {
    transition: transform var(--dur-fast) var(--ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover :global(.btn__icon--right) {
      transform: none;
    }
  }
</style>
