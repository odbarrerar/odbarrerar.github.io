---
/**
 * Compact bibliographic entry: year in the margin, full author list,
 * venue, typed links and an expandable citation.
 */
import AuthorList from './AuthorList.astro';
import CitationBlock from './CitationBlock.astro';
import PaperLinks from './PaperLinks.astro';
import Tag from './Tag.astro';
import { STATUS_LABEL, groupOf, paperUrl, venueParts, type Paper } from '../lib/research';

interface Props {
  paper: Paper;
  level?: 2 | 3 | 4;
  cite?: boolean;
}

const { paper, level = 3, cite = true } = Astro.props;
const d = paper.data;
const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
const group = groupOf(d.status);
const { venue, details } = venueParts(paper);
---

<li
  class="pub"
  data-filter-item
  data-group={group}
  data-topics={d.topics.join(' ')}
  data-year={d.year ?? ''}
  data-title={d.title}
>
  <p class="pub__year tnum">{d.year ?? '—'}</p>
  <div class="pub__body">
    <Heading class="pub__title"><a href={paperUrl(paper)}>{d.title}</a></Heading>
    <AuthorList authors={d.authors} mode="all" class="pub__authors" />
    <p class="pub__venue">
      {venue && <cite>{venue}</cite>}{venue && details && <span class="num">, {details.replace(/ · \d{4}$/, '')}</span>}
    </p>
    <p class="pub__statusline">
      {d.job_market_paper && <Tag variant="accent" marker="jmp">Job market paper</Tag>}
      <Tag variant="status" marker={group}>{STATUS_LABEL[d.status]}</Tag>
    </p>
    <div class="pub__actions">
      <PaperLinks paper={paper} />
      {cite && d.status !== 'work-in-progress' && <CitationBlock paper={paper} collapsible />}
    </div>
  </div>
</li>

<style>
  .pub {
    display: grid;
    grid-template-columns: 3.75rem minmax(0, 1fr);
    gap: 0 var(--space-m);
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 48em) {
    .pub {
      grid-template-columns: 5rem minmax(0, 1fr);
    }
  }

  .pub__year {
    padding-top: 0.2rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--color-text-subtle);
  }

  .pub__title {
    font-size: var(--step-1);
    font-weight: 480;
    line-height: 1.3;
    max-width: 48rem;
  }

  .pub__title a {
    color: inherit;
    text-decoration: none;
  }

  .pub__title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .pub__body :global(.pub__authors) {
    margin-top: 0.4rem;
  }

  .pub__venue {
    margin-top: 0.25rem;
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .pub__venue:empty {
    display: none;
  }

  .pub__venue cite {
    color: var(--color-text);
  }

  .pub__statusline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: 0.45rem;
  }

  .pub__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.4rem 1.1rem;
    margin-top: 0.8rem;
  }

  .pub__actions > :global(*) {
    min-width: 0;
    max-width: 100%;
  }

  .pub__actions :global(.cite--collapsible) {
    flex-basis: auto;
  }

  .pub__actions :global(.cite--collapsible[open]) {
    flex-basis: 100%;
  }
</style>
