---
/** "Back to top" link that appears after scrolling down long pages. */
import Icon from './Icon.astro';
---

<a href="#top" class="back-to-top js-only" data-back-to-top hidden>
  <Icon name="arrow-up" />
  <span class="visually-hidden">Back to top</span>
</a>

<script>
  const link = document.querySelector<HTMLAnchorElement>('[data-back-to-top]');
  if (link) {
    let ticking = false;
    const update = () => {
      link.hidden = window.scrollY < window.innerHeight * 1.5;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
    link.addEventListener('click', () => {
      // "#top" scrolls to the start of the document (HTML standard);
      // move keyboard focus there as well
      window.setTimeout(() => document.querySelector<HTMLElement>('.wordmark')?.focus({ preventScroll: true }), 0);
    });
  }
</script>

<style>
  .back-to-top {
    position: fixed;
    right: clamp(0.9rem, 2vw, 1.75rem);
    bottom: clamp(0.9rem, 2vw, 1.75rem);
    z-index: 40;
    display: inline-grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: var(--shadow-overlay);
    font-size: 1.1rem;
    text-decoration: none;
  }

  .back-to-top:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
