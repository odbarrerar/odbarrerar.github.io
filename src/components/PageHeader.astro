---
/** Title block at the top of inner pages. */
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  breadcrumbs?: Crumb[];
}

const { title, eyebrow, intro, breadcrumbs } = Astro.props;
---

<header class="page-header">
  <div class="container">
    {breadcrumbs && breadcrumbs.length > 1 && <Breadcrumbs items={breadcrumbs} />}
    {eyebrow && <p class="eyebrow page-header__eyebrow">{eyebrow}</p>}
    <h1 class="page-header__title">{title}</h1>
    {intro && <p class="lede page-header__intro">{intro}</p>}
    <div class="page-header__extra">
      <slot />
    </div>
  </div>
</header>

<style>
  .page-header {
    padding-top: clamp(1.75rem, 1.2rem + 2.6vw, 3.75rem);
    padding-bottom: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem);
    border-bottom: 1px solid var(--color-border);
  }

  .page-header :global(.breadcrumbs) {
    margin-bottom: clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem);
  }

  .page-header__eyebrow {
    margin-bottom: 1rem;
  }

  .page-header__title {
    max-width: 22ch;
  }

  .page-header__intro {
    margin-top: 1.25rem;
  }

  .page-header__extra:empty {
    display: none;
  }

  .page-header__extra {
    margin-top: var(--space-l);
  }
</style>
