---
/**
 * Portrait photo. Drop an image named `portrait.jpg` (or .jpeg/.png/.webp)
 * into src/assets/images/ and it is used automatically, resized and
 * converted to AVIF/WebP at build time. Until then, a monogram is shown.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { profile } from '../lib/data';

interface Props {
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  widths = [320, 480, 640, 800],
  sizes = '(min-width: 64em) 22rem, (min-width: 40em) 40vw, 80vw',
  loading = 'lazy',
  class: className,
} = Astro.props;

const found = import.meta.glob<{ default: ImageMetadata }>('../assets/images/portrait.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const image = Object.values(found)[0]?.default;
const initials = profile.name
  .split(/\s+/)
  .filter((w) => /^[A-ZÁÉÍÓÚÑ]/.test(w))
  .slice(0, 2)
  .map((w) => w[0])
  .join('');
---

<figure class:list={['portrait', className]}>
  {
    image ? (
      <Picture
        src={image}
        alt={`Portrait of ${profile.name}`}
        widths={widths}
        width={Math.max(...widths)}
        sizes={sizes}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        loading={loading}
        fetchpriority={loading === 'eager' ? 'high' : 'auto'}
        class="portrait__img"
        pictureAttributes={{ class: 'portrait__picture' }}
      />
    ) : (
      <div class="portrait__placeholder" role="img" aria-label={`Monogram of ${profile.name}`}>
        <span>{initials}</span>
      </div>
    )
  }
</figure>

<style>
  .portrait {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    width: 100%;
    background: var(--color-bg-soft);
    border-radius: var(--radius-s);
    overflow: hidden;
  }

  .portrait :global(.portrait__picture),
  .portrait :global(.portrait__img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .portrait :global(.portrait__img) {
    object-fit: cover;
    object-position: 50% 30%;
  }

  .portrait__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: var(--color-bg-soft);
    box-shadow: inset 0 0 0 0.75rem var(--color-bg-soft), inset 0 0 0 calc(0.75rem + 1px) var(--color-border);
  }

  .portrait__placeholder span {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 1.4rem + 5vw, 5.5rem);
    font-weight: 300;
    letter-spacing: 0.02em;
    color: var(--color-accent);
  }
</style>
