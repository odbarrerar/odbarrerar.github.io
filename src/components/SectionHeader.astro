---
/**
 * Section heading with an optional number, short introduction and a
 * right-aligned "view all" link.
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  id?: string;
  number?: string;
  eyebrow?: string;
  intro?: string;
  href?: string;
  linkLabel?: string;
  level?: 2 | 3;
}

const { title, id, number, eyebrow, intro, href, linkLabel = 'View all', level = 2 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<header class="section-header">
  <div class="section-header__main">
    {
      (number || eyebrow) && (
        <p class="section-header__eyebrow">
          {number && <span class="section-header__num num">{number}</span>}
          {eyebrow && <span>{eyebrow}</span>}
        </p>
      )
    }
    <Heading id={id} class="section-header__title">{title}</Heading>
    {intro && <p class="section-header__intro">{intro}</p>}
    <slot />
  </div>
  {
    href && (
      <a class="section-header__link" href={href}>
        {linkLabel}
        <Icon name="arrow-right" />
      </a>
    )
  }
</header>

<style>
  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    margin-bottom: clamp(1.75rem, 1.2rem + 2vw, 3rem);
  }

  .section-header__main {
    max-width: 46rem;
  }

  .section-header__eyebrow {
    display: flex;
    align-items: baseline;
    gap: 0.8em;
    margin-bottom: 0.9rem;
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .section-header__num {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-text-subtle);
  }

  .section-header__num::after {
    content: '';
    display: inline-block;
    width: 1.75rem;
    height: 1px;
    margin-left: 0.8em;
    vertical-align: middle;
    background: var(--color-border-strong);
  }

  .section-header__intro {
    margin-top: 0.85rem;
    color: var(--color-text-muted);
    font-size: var(--step-0);
    max-width: 40rem;
  }

  .section-header__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding-block: 0.4rem;
    font-size: var(--step--1);
    font-weight: 560;
    text-decoration: none;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border-strong);
  }

  .section-header__link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
